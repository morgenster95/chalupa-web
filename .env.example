# Zkopírujte do .env.local a doplňte. Bez vyplnění běží web v lokálním režimu
# (data v .data/db.json, e-maily ve „Vývojové poště“, platba kartou se simuluje).

SITE_URL=http://localhost:3000
APP_SECRET=nahodny-retezec-minimalne-32-znaku
ADMIN_EMAILS=vas.email@gmail.com
# OWNER_EMAIL=          # volitelné: kam chodí poptávky (jinak e-mail z nastavení)

# Firebase – servisní účet pro lokální připojení k Firestore (JSON nebo base64)
# FIREBASE_SERVICE_ACCOUNT=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Resend
# RESEND_API_KEY=re_...
# EMAIL_FROM="Chalupa <rezervace@vase-domena.cz>"

# Stripe (testovací klíče začínají sk_test_ / whsec_)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare Turnstile (volitelné, ochrana kontaktního formuláře)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Tajný klíč pro /api/cron
CRON_SECRET=nahodny-retezec
